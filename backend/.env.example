# Copy to .env and fill in. .env is git-ignored.
ADAPTER=mock                       # mock | ecurious
ECURIOUS_BASE_URL=https://parking-lock-service-production.up.railway.app
ECURIOUS_API_KEY=                  # team key, never commit
LOCK_IDS=lock-0002,lock-0003       # locks assigned to our key; seeded as bay-1, bay-2
DB_PATH=data.db
GRACE_MINUTES=15                   # [TEAM B4]; use 1 for the demo
CAMERA_STALE_SECONDS=120           # no lock update for this long -> bay shows "unverified" [GAP C12]
POLL_SECONDS=5                     # status poll; also covers SSE gaps. 0 disables
# Frontend only: GoingElectric terms say the client fetches directly, never via our backend
OPERATOR_TOKEN=                    # required on any public deploy; empty = operator routes open
GOINGELECTRIC_API_KEY=
